{
  "id": "mi.hls",
  "name": "Mi HLS",
  "version": "0.2.0",
  "apiVersion": 20,
  "description": "Reproductor HLS: pega URLs m3u8 o recibe streams de otros plugins",
  "provides": {
    "player": {
      "accepts": ["hls", "m3u8", "url.video"],
      "entry": "onReceiveStream"
    }
  },
  "consumes": {
    "player": {
      "contract": "kino.player.stream.v1"
    }
  },
  "settings": [
    {
      "key": "hlsUrl",
      "type": "url",
      "label": "URL HLS (.m3u8)"
    },
    {
      "key": "subtitleUrl",
      "type": "url",
      "label": "Subtítulos (opcional)"
    }
  ]
}
